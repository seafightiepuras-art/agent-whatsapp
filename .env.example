# Copiază acest fișier ca .env.local și completează valorile. NU le pune niciodată în chat sau pe GitHub.

# Supabase (poate fi același proiect ca la pontaj; tabelele agentului încep cu "agent_")
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Cheia Anthropic (aceeași ca la aplicația de cheltuieli)
ANTHROPIC_API_KEY=

# Meta WhatsApp Cloud API
WHATSAPP_TOKEN=              # token-ul din API Setup (temporar ~24h) sau cel permanent de System User
WHATSAPP_PHONE_NUMBER_ID=    # "Phone number ID" din API Setup
WHATSAPP_VERIFY_TOKEN=       # un text inventat de tine; același îl scrii la Meta, la configurarea webhook-ului
WHATSAPP_APP_SECRET=         # App Settings > Basic > App secret (verifică semnătura mesajelor)
WHATSAPP_SABLON_MEMENTO=     # (opțional) numele șablonului aprobat, pentru memento-uri după >24h de la ultimul mesaj

# Cine are voie să vorbească cu agentul: număr (doar cifre, cu prefix de țară) = Nume, separate prin virgulă
# Exemplu: 40724206225=Angel,40700000000=Soția
NUMERE_PERMISE=

# Secret pentru apelul periodic care trimite memento-urile (inventează un text lung)
CRON_SECRET=
